# Copie para .env (NUNCA versione o .env real).

# ---- Geral (desenvolvimento) ----
DEBUG=true
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Sao_Paulo
SITE_URL=http://localhost:8000

# ---- Banco: SQLite (padrão local) ----
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# ---- Banco: PostgreSQL local (alternativa 1: variáveis separadas) ----
# DB_ENGINE=postgresql
# DB_DATABASE=barbearia_db
# DB_USER=barbearia_user
# DB_PASSWORD=defina-sua-senha-local
# DB_HOST=localhost
# DB_PORT=5432

# ---- Banco: PostgreSQL (alternativa 2, preferencial; é a usada no Render) ----
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/barbearia_db
DB_CONN_MAX_AGE=60

# ---- CORS / CSRF / cookies ----
# Desenvolvimento com proxy do Vite: não precisa de CORS.
# Desenvolvimento chamando http://localhost:8000 direto do Vite:
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Produção (HTTPS, sem barra final, nunca "*"):
# CORS_ALLOWED_ORIGINS=https://barbearia-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://barbearia-frontend.onrender.com
# SESSION_COOKIE_SAMESITE=None   # padrão em produção; use Lax se usar domínio próprio same-site
# CSRF_COOKIE_SAMESITE=None

# ---- HTTPS (produção) ----
# USE_PROXY_SSL_HEADER=true
# SECURE_HSTS_SECONDS=3600

# ---- Upload ----
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# ---- Mídia: local (desenvolvimento) ----
MEDIA_STORAGE=local
MEDIA_ROOT=media
# Persistent Disk (plano pago): MEDIA_ROOT=/var/data/media

# ---- Mídia: armazenamento S3 compatível (produção) ----
# MEDIA_STORAGE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   # vazio na AWS S3
# AWS_S3_REGION_NAME=auto                                              # R2: auto | AWS: us-east-1
# AWS_S3_CUSTOM_DOMAIN=pub-xxxxxxxx.r2.dev                             # domínio público dos arquivos