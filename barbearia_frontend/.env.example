# Copie para .env. Atenção: variáveis VITE_* FICAM VISÍVEIS no bundle final.
# NUNCA coloque segredos aqui.

# Desenvolvimento (recomendado): deixe VAZIO para usar o proxy do Vite
# (/api e /media vão para o Django na mesma origem; sem CORS).
VITE_API_BASE_URL=

# Alternativa em desenvolvimento, chamando o Django direto:
# VITE_API_BASE_URL=http://localhost:8000
# (exige no backend: CORS_ALLOWED_ORIGINS=http://localhost:5173 e
#  CSRF_TRUSTED_ORIGINS=http://localhost:5173)

# PRODUÇÃO: URL HTTPS do Web Service Django, SEM barra final. Exemplo:
# VITE_API_BASE_URL=https://barbearia-api.onrender.com
# É lida durante o build; alterar exige novo deploy do Static Site.

# Destino do proxy do Vite em desenvolvimento (servidor Django).
VITE_PROXY_TARGET=http://localhost:8000